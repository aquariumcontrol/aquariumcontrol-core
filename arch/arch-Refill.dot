digraph archRefill {
    fontname="Helvetica,Arial,sans-serif"
    node [fontname="Helvetica,Arial,sans-serif"]
    edge [fontname="Helvetica,Arial,sans-serif"][penwidth=2.0]
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] execute;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] execute_refill;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] update_tank_level_switch_signals;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] check_pending_external_request;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] get_sql_refill_data;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] check_volume_count_time_limits;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] check_error_condition_switch_stuck_high;
    node [shape=box fillcolor="white:gray" style=filled gradientangle=270] calc_tank_level_switch_position_stabilized;
    
    execute-> calc_tank_level_switch_position_stabilized;
    execute->get_sql_refill_data;
    execute->check_error_condition_switch_stuck_high;
    execute_refill->check_pending_external_request;
    execute->check_pending_external_request;
    execute->update_tank_level_switch_signals;
    execute_refill->update_tank_level_switch_signals;
    execute->check_volume_count_time_limits;
    execute->execute_refill;
    
    label="Achitecture of Refill component";
    fontsize=20;
}